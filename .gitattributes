# Normaliza fim de linha: LF no repositorio, nativo no checkout.
* text=auto eol=lf

# Binarios — nunca converter
*.png binary
*.jpg binary
*.ico binary
*.zip binary
*.db binary

# Scripts do Windows precisam de CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Linguagens do projeto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
